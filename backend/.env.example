# Backend server configuration
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Document processing limits
MAX_UPLOAD_SIZE_MB=10
MAX_TEXT_LENGTH_CHARS=50000

# AWS & Amazon Bedrock Configuration
# Note: In production or AWS environments, credentials can be picked up automatically via IAM roles.
# For local testing, configure these or use your standard ~/.aws/credentials file.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Optional explicit credentials for local development only (Do NOT commit real keys!)
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_SESSION_TOKEN=your-session-token-if-using-temporary-credentials
